# Copy to .env.local for local use, and add the same variables in Vercel > Project > Settings > Environment Variables.

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the SERVICE ROLE key. It is only ever used on the server (API routes). Never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Long random string used to sign login cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
